{
  "schema_version": "1.0",
  "profile_id": "sports_discussion",
  "display_name": "Sports Discussion 4-Camera Debate",
  "description": "4-camera sports studio debate profile with dynamic desk-wide overlap switching, punchy analyst cutaways, and broadcast ticker styling.",
  "format_type": "sports_discussion",
  "video_spec": {
    "width": 1920,
    "height": 1080,
    "fps_num": 25,
    "fps_den": 1,
    "color_space": "bt709"
  },
  "cameras": [
    {
      "camera_id": "cam_desk",
      "role": "desk",
      "speaker_label": null,
      "priority": 1
    },
    {
      "camera_id": "cam_host",
      "role": "host",
      "speaker_label": "Host",
      "priority": 2
    },
    {
      "camera_id": "cam_guest",
      "role": "guest",
      "speaker_label": "Guest",
      "priority": 2
    },
    {
      "camera_id": "cam_panel",
      "role": "panel",
      "speaker_label": "Panel",
      "priority": 3
    }
  ],
  "camera_roles": {
    "cam_desk": "desk",
    "cam_host": "host",
    "cam_guest": "guest",
    "cam_panel": "panel"
  },
  "speaker_camera_map": {
    "Host": "cam_host",
    "Guest": "cam_guest",
    "Panel": "cam_panel"
  },
  "camera_preferences": {
    "prefer_wide_on_overlap": true,
    "default_opening_role": "desk",
    "avoid_jump_cuts": true
  },
  "wide_shot_interval_sec": 14.0,
  "reaction_shot_frequency": 0.6,
  "min_shot_duration_sec": 1.5,
  "max_shot_duration_sec": 8.0,
  "silence_threshold_db": -35.0,
  "loudness_target_lufs": -16.0,
  "intro_outro_rules": {
    "open_on_wide": true,
    "opening_wide_sec": 2.0,
    "close_on_wide": true,
    "closing_wide_sec": 2.0,
    "intro_asset": null,
    "outro_asset": null,
    "fade_in_sec": 0.0,
    "fade_out_sec": 0.4
  },
  "editing_rules": {
    "min_shot_sec": 1.5,
    "max_shot_sec": 8.0,
    "min_shot_duration_sec": 1.5,
    "max_shot_duration_sec": 8.0,
    "wide_shot_interval_sec": 14.0,
    "reaction_shot_frequency": 0.6,
    "reaction_cut_interval_sec": 4.5,
    "silence_threshold_db": -35.0,
    "min_silence_sec": 0.6,
    "interruption_gap_sec": 10.0,
    "excise_interruption_gaps": true,
    "overlap_cut_to_wide": true,
    "keep_padding_sec": 0.15,
    "trim_setup_delay": true,
    "review_confidence_threshold": 0.74
