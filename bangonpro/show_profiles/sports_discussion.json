    "uppercase": false,
    "burn_in": false
  },
  "delivery_spec": {
    "container": "mp4",
    "video_codec": "libx264",
    "audio_codec": "aac",
    "width": 1920,
    "height": 1080,
    "fps_num": 25,
    "fps_den": 1,
    "color_space": "bt709",
    "audio_sample_rate": 48000,
    "audio_channels": 2,
    "target_lufs": -16.0,
    "true_peak_dbtp": -1.5,
    "video_bitrate": "15M",
    "audio_bitrate": "192k"
