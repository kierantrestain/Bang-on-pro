    "enable_denoise": true,
    "enable_compressor": true,
    "enable_mic_level_matching": true,
    "max_mic_trim_db": 24.0,
    "music_duck_db": -18.0
  },
  "graphics_rules": {
    "enable_captions": true,
    "enable_lower_thirds": true,
    "lower_third_duration_sec": 4.0,
    "brand_accent_hex": "#00A8E8"
  },
  "graphics_templates": {
    "lower_third_template": "sports_analyst_chyron",
    "lower_third_position": "bottom_left",
    "title_card_template": "sports_segment_slate",
    "bug_position": "top_right",
    "font_family": "DejaVu Sans",
    "accent_hex": "#00A8E8"
  },
  "caption_style": {
    "font_family": "DejaVu Sans",
    "font_size_px": 48,
