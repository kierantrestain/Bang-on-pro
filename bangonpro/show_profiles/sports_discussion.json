{
  "schema_version": "1.0",
  "profile_id": "sports_discussion",
  "display_name": "Sports Discussion 4-Camera Debate",
  "format_type": "sports_discussion",
  "video_spec": {
    "width": 1920,
    "height": 1080,
    "fps_num": 25,
    "fps_den": 1,
    "color_space": "bt709"
  },
  "cameras": [
    {
      "camera_id": "cam_desk",
      "role": "desk",
      "speaker_label": null,
      "priority": 1
    },
    {
      "camera_id": "cam_host",
      "role": "host",
      "speaker_label": "Host",
      "priority": 2
    },
    {
      "camera_id": "cam_guest",
      "role": "guest",
      "speaker_label": "Guest",
      "priority": 2
    },
    {
      "camera_id": "cam_panel",
      "role": "panel",
      "speaker_label": "Panel",
      "priority": 3
    }
  ],
  "editing_rules": {
    "min_shot_sec": 1.5,
    "max_shot_sec": 8.0,
    "reaction_cut_interval_sec": 4.5,
    "silence_threshold_db": -35.0,
    "min_silence_sec": 0.6,
    "keep_padding_sec": 0.15,
    "trim_setup_delay": true,
    "review_confidence_threshold": 0.74
  },
  "audio_rules": {
    "target_lufs": -16.0,
    "true_peak_dbtp": -1.5,
    "enable_denoise": true,
    "enable_compressor": true,
    "music_duck_db": -18.0
  },
  "graphics_rules": {
    "enable_captions": true,
    "enable_lower_thirds": true,
    "lower_third_duration_sec": 4.0,
    "brand_accent_hex": "#00A8E8"
  },
  "export_presets": [
    {
      "name": "sports_broadcast_1080p",
      "container": "mp4",
      "video_codec": "libx264",
      "audio_codec": "aac",
      "video_bitrate": "15M",
      "audio_bitrate": "192k"
    },
    {
      "name": "sports_web_1080p",
      "container": "mp4",
      "video_codec": "libx264",
      "audio_codec": "aac",
      "video_bitrate": "8M",
      "audio_bitrate": "160k"
    }
  ]
}
