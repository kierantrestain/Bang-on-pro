{
  "schema_version": "1.0",
  "profile_id": "daily_news",
  "display_name": "Daily News Broadcast Desk",
  "format_type": "daily_news",
  "video_spec": {
    "width": 1920,
    "height": 1080,
    "fps_num": 25,
    "fps_den": 1,
    "color_space": "bt709"
  },
  "cameras": [
    {
      "camera_id": "cam_desk",
      "role": "desk",
      "speaker_label": "Host",
      "priority": 2
    },
    {
      "camera_id": "cam_broll",
      "role": "broll",
      "speaker_label": null,
      "priority": 1
    }
  ],
  "editing_rules": {
    "min_shot_sec": 2.0,
    "max_shot_sec": 10.0,
    "reaction_cut_interval_sec": 6.0,
    "silence_threshold_db": -34.0,
    "min_silence_sec": 0.4,
    "keep_padding_sec": 0.1,
    "trim_setup_delay": true,
    "review_confidence_threshold": 0.78
  },
  "audio_rules": {
    "target_lufs": -16.0,
    "true_peak_dbtp": -1.5,
    "enable_denoise": true,
    "enable_compressor": true,
    "music_duck_db": -20.0
  },
  "graphics_rules": {
    "enable_captions": true,
    "enable_lower_thirds": true,
    "lower_third_duration_sec": 5.0,
    "brand_accent_hex": "#D90429"
  },
  "export_presets": [
    {
      "name": "news_broadcast_1080p",
      "container": "mp4",
      "video_codec": "libx264",
      "audio_codec": "aac",
      "video_bitrate": "12M",
      "audio_bitrate": "192k"
    },
    {
      "name": "news_web_bulletin",
      "container": "mp4",
      "video_codec": "libx264",
      "audio_codec": "aac",
      "video_bitrate": "6M",
      "audio_bitrate": "128k"
    }
  ]
}
