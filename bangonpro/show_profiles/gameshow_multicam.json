{
  "schema_version": "1.0",
  "profile_id": "gameshow_multicam",
  "display_name": "Gameshow 4-Camera Fast-Paced",
  "description": "High-energy 4-camera gameshow profile with rapid reaction cutaways, tight dead-air reduction, bold amber graphics, and applause-triggered switching.",
  "format_type": "gameshow",
  "video_spec": {
    "width": 1920,
    "height": 1080,
    "fps_num": 25,
    "fps_den": 1,
    "color_space": "bt709"
  },
  "cameras": [
    {
      "camera_id": "cam_wide",
      "role": "wide",
      "speaker_label": null,
      "priority": 1
    },
    {
      "camera_id": "cam_host",
      "role": "host",
      "speaker_label": "Host",
      "priority": 2
    },
    {
      "camera_id": "cam_panel",
      "role": "panel",
      "speaker_label": "Panel",
      "priority": 2
    },
    {
      "camera_id": "cam_reaction",
      "role": "reaction",
      "speaker_label": "Contestant",
      "priority": 3
    }
  ],
  "camera_roles": {
    "cam_wide": "wide",
    "cam_host": "host",
    "cam_panel": "panel",
    "cam_reaction": "reaction"
  },
  "speaker_camera_map": {
    "Host": "cam_host",
    "Panel": "cam_panel",
    "Contestant": "cam_reaction"
  },
  "camera_preferences": {
    "prefer_wide_on_overlap": true,
    "default_opening_role": "wide",
    "avoid_jump_cuts": true
  },
  "wide_shot_interval_sec": 12.0,
  "reaction_shot_frequency": 0.75,
  "min_shot_duration_sec": 1.2,
  "max_shot_duration_sec": 6.5,
  "silence_threshold_db": -34.0,
  "loudness_target_lufs": -16.0,
  "intro_outro_rules": {
    "open_on_wide": true,
    "opening_wide_sec": 1.5,
    "close_on_wide": true,
    "closing_wide_sec": 1.5,
    "intro_asset": null,
    "outro_asset": null,
    "fade_in_sec": 0.0,
    "fade_out_sec": 0.25
  },
  "editing_rules": {
    "min_shot_sec": 1.2,
    "max_shot_sec": 6.5,
    "min_shot_duration_sec": 1.2,
    "max_shot_duration_sec": 6.5,
    "wide_shot_interval_sec": 12.0,
    "reaction_shot_frequency": 0.75,
    "reaction_cut_interval_sec": 3.5,
    "silence_threshold_db": -34.0,
    "min_silence_sec": 0.55,
    "interruption_gap_sec": 8.0,
    "excise_interruption_gaps": true,
    "overlap_cut_to_wide": true,
    "keep_padding_sec": 0.15,
    "trim_setup_delay": true,
    "review_confidence_threshold": 0.75
  },
  "audio_rules": {
    "target_lufs": -16.0,
    "loudness_target_lufs": -16.0,
    "true_peak_dbtp": -1.5,
    "highpass_hz": 85.0,
    "enable_denoise": true,
    "enable_compressor": true,
    "enable_mic_level_matching": true,
    "max_mic_trim_db": 20.0,
    "music_duck_db": -16.0
  },
  "graphics_rules": {
    "enable_captions": true,
    "enable_lower_thirds": true,
    "lower_third_duration_sec": 3.5,
    "brand_accent_hex": "#FFB800"
  },
  "graphics_templates": {
    "lower_third_template": "gameshow_scoreboard_banner",
    "lower_third_position": "bottom_center",
    "title_card_template": "gameshow_round_bumper",
    "bug_position": "top_left",
    "font_family": "DejaVu Sans",
    "accent_hex": "#FFB800"
  },
  "caption_style": {
    "font_family": "DejaVu Sans",
    "font_size_px": 54,
    "primary_color_hex": "#FFFFFF",
    "highlight_color_hex": "#FFB800",
    "outline_color_hex": "#101010",
    "outline_width": 4.0,
    "alignment": "bottom_center",
    "max_chars_per_line": 36,
    "uppercase": true,
    "burn_in": false
  },
  "delivery_spec": {
    "container": "mp4",
    "video_codec": "libx264",
    "audio_codec": "aac",
    "width": 1920,
    "height": 1080,
    "fps_num": 25,
    "fps_den": 1,
    "color_space": "bt709",
    "audio_sample_rate": 48000,
    "audio_channels": 2,
    "target_lufs": -16.0,
    "true_peak_dbtp": -1.5,
    "video_bitrate": "14M",
    "audio_bitrate": "192k"
  },
  "export_presets": [
