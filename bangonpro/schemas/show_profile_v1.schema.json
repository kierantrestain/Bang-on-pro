{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangonpro.dev/schemas/show_profile_v1.schema.json",
  "title": "Bang On Pro Show Profile v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "format_type",
    "video_spec",
    "cameras",
    "editing_rules",
    "audio_rules",
    "graphics_rules",
    "export_presets"
  ],
  "properties": {
    "agent_config": {
      "type": "object",
      "description": "V1.2 production department: per-profile agent activation",
      "properties": {
        "disabled_agents": { "type": "array", "items": { "type": "string" } },
        "default_mode": { "type": "string", "enum": ["manual", "assisted", "autonomous_first_cut", "full_production_draft"] }
      },
      "additionalProperties": true
    },
    "colour_rules": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "reference_camera": { "type": ["string", "null"] },
        "correct_exposure": { "type": "boolean" },
        "target_luma": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
        "max_channel_gain": { "type": "number", "minimum": 1.0, "maximum": 2.0 },
        "lut_path": { "type": ["string", "null"] },
        "treatment": { "type": "string" }
      },
      "additionalProperties": true
    },
    "vfx_rules": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["effect"],
            "properties": {
              "effect": { "type": "string", "enum": ["blur_background", "replace_background"] },
              "camera_roles": { "type": "array", "items": { "type": "string" } },
              "camera_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "blur_strength": { "type": "number", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": true
    },
    "distribution_rules": {
      "type": "object",
      "properties": {
        "social_versions": { "type": "boolean" },
        "highlight_reel": { "type": "boolean" },
        "highlight_count": { "type": "integer", "minimum": 0, "maximum": 50 },
        "social_aspect": { "type": "string" },
        "loudness_tolerance_lu": { "type": "number", "minimum": 0.1, "maximum": 6 }
      },
      "additionalProperties": true
    },
    "series": {
      "type": "object",
      "properties": {
        "series_id": { "type": ["string", "null"] },
        "episode_number_format": { "type": "string" },
        "consistent_standards": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "schema_version": { "type": "string", "const": "1.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "format_type": {
      "type": "string",
      "enum": ["podcast", "gameshow", "sports_discussion", "daily_news", "interview", "social", "custom"]
    },
    "video_spec": {
      "type": "object",
      "required": ["width", "height", "fps_num", "fps_den"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "fps_num": { "type": "integer", "minimum": 1 },
        "fps_den": { "type": "integer", "minimum": 1 },
        "color_space": { "type": "string", "default": "bt709" }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["camera_id", "role"],
        "properties": {
          "camera_id": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": [
              "wide",
              "host",
              "guest",
              "panel",
              "reaction",
              "overhead",
              "desk",
              "broll",
              "audio_recorder"
            ]
          },
          "speaker_label": { "type": ["string", "null"] },
          "priority": { "type": "integer", "default": 1 }
        }
      }
    },
    "camera_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "wide",
          "host",
          "guest",
          "panel",
          "reaction",
          "overhead",
          "desk",
          "broll",
          "audio_recorder"
        ]
      }
    },
    "speaker_camera_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "wide_shot_interval_sec": { "type": "number", "minimum": 2.0 },
    "reaction_shot_frequency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "min_shot_duration_sec": { "type": "number", "minimum": 0.4 },
    "max_shot_duration_sec": { "type": "number", "minimum": 1.0 },
    "silence_threshold_db": { "type": "number", "minimum": -90.0, "maximum": 0.0 },
    "loudness_target_lufs": { "type": "number", "minimum": -40.0, "maximum": -6.0 },
    "camera_preferences": {
      "type": "object",
      "properties": {
        "prefer_wide_on_overlap": { "type": "boolean", "default": true },
        "default_opening_role": {
          "type": "string",
          "enum": ["wide", "host", "guest", "panel", "reaction", "overhead", "desk", "broll"],
          "default": "wide"
        },
        "avoid_jump_cuts": { "type": "boolean", "default": true }
      }
    },
    "intro_outro_rules": {
      "type": "object",
      "properties": {
        "open_on_wide": { "type": "boolean", "default": true },
        "opening_wide_sec": { "type": "number", "minimum": 0.0, "maximum": 30.0, "default": 2.5 },
        "close_on_wide": { "type": "boolean", "default": true },
        "closing_wide_sec": { "type": "number", "minimum": 0.0, "maximum": 30.0, "default": 2.0 },
        "intro_asset": { "type": ["string", "null"], "default": null },
        "outro_asset": { "type": ["string", "null"], "default": null },
        "fade_in_sec": { "type": "number", "minimum": 0.0, "maximum": 5.0, "default": 0.0 },
        "fade_out_sec": { "type": "number", "minimum": 0.0, "maximum": 5.0, "default": 0.5 }
      }
    },
    "editing_rules": {
      "type": "object",
      "required": ["min_shot_sec", "max_shot_sec", "silence_threshold_db", "min_silence_sec"],
      "properties": {
        "min_shot_sec": { "type": "number", "minimum": 0.4 },
        "max_shot_sec": { "type": "number", "minimum": 1.0 },
        "min_shot_duration_sec": { "type": "number", "minimum": 0.4 },
        "max_shot_duration_sec": { "type": "number", "minimum": 1.0 },
        "wide_shot_interval_sec": { "type": "number", "minimum": 2.0 },
        "reaction_shot_frequency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reaction_cut_interval_sec": { "type": "number", "minimum": 1.5 },
        "silence_threshold_db": { "type": "number" },
        "min_silence_sec": { "type": "number", "minimum": 0.1 },
        "interruption_gap_sec": { "type": "number", "minimum": 2.0, "default": 10.0 },
        "excise_interruption_gaps": { "type": "boolean", "default": true },
        "overlap_cut_to_wide": { "type": "boolean", "default": true },
        "keep_padding_sec": { "type": "number", "minimum": 0.0 },
        "trim_setup_delay": { "type": "boolean", "default": true },
        "review_confidence_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.72 }
      }
    },
    "audio_rules": {
      "type": "object",
      "properties": {
        "target_lufs": { "type": "number", "default": -16.0 },
        "loudness_target_lufs": { "type": "number", "default": -16.0 },
        "true_peak_dbtp": { "type": "number", "default": -1.5 },
        "highpass_hz": { "type": "number", "minimum": 20.0, "maximum": 300.0, "default": 80.0 },
        "enable_denoise": { "type": "boolean", "default": true },
        "enable_compressor": { "type": "boolean", "default": true },
        "enable_mic_level_matching": { "type": "boolean", "default": true },
        "max_mic_trim_db": { "type": "number", "minimum": 0.0, "maximum": 24.0, "default": 24.0 },
        "music_duck_db": { "type": "number", "default": -18.0 }
      }
    },
    "graphics_rules": {
      "type": "object",
      "properties": {
        "enable_captions": { "type": "boolean", "default": true },
        "enable_lower_thirds": { "type": "boolean", "default": true },
        "lower_third_duration_sec": { "type": "number", "default": 4.5 },
        "brand_accent_hex": { "type": "string", "default": "#FF5A1F" }
      }
    },
    "graphics_templates": {
      "type": "object",
      "properties": {
        "lower_third_template": { "type": "string", "minLength": 1 },
        "lower_third_position": {
          "type": "string",
          "enum": ["bottom_left", "bottom_center", "bottom_right", "top_left", "top_right"],
          "default": "bottom_left"
        },
        "title_card_template": { "type": "string" },
        "bug_position": {
          "type": "string",
          "enum": ["none", "top_left", "top_right", "bottom_left", "bottom_right"],
          "default": "top_right"
        },
        "font_family": { "type": "string", "default": "DejaVu Sans" },
        "accent_hex": { "type": "string", "default": "#FF5A1F" }
      }
    },
    "caption_style": {
      "type": "object",
      "properties": {
        "font_family": { "type": "string", "default": "DejaVu Sans" },
        "font_size_px": { "type": "integer", "minimum": 14, "maximum": 144, "default": 48 },
        "primary_color_hex": { "type": "string", "default": "#FFFFFF" },
        "highlight_color_hex": { "type": "string", "default": "#FF5A1F" },
        "outline_color_hex": { "type": "string", "default": "#121212" },
        "outline_width": { "type": "number", "minimum": 0.0, "maximum": 12.0, "default": 3.0 },
        "alignment": {
          "type": "string",
          "enum": ["bottom_left", "bottom_center", "bottom_right", "top_center"],
          "default": "bottom_center"
        },
        "max_chars_per_line": { "type": "integer", "minimum": 16, "maximum": 120, "default": 42 },
        "uppercase": { "type": "boolean", "default": false },
        "burn_in": { "type": "boolean", "default": false }
      }
    },
    "delivery_spec": {
      "type": "object",
      "properties": {
        "container": { "type": "string", "default": "mp4" },
        "video_codec": { "type": "string", "default": "libx264" },
        "audio_codec": { "type": "string", "default": "aac" },
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "fps_num": { "type": "integer", "minimum": 1 },
        "fps_den": { "type": "integer", "minimum": 1 },
        "color_space": { "type": "string", "default": "bt709" },
        "audio_sample_rate": { "type": "integer", "minimum": 8000, "default": 48000 },
        "audio_channels": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
        "target_lufs": { "type": "number", "minimum": -40.0, "maximum": -6.0, "default": -16.0 },
        "true_peak_dbtp": { "type": "number", "minimum": -12.0, "maximum": 0.0, "default": -1.5 },
        "video_bitrate": { "type": "string", "default": "12M" },
        "audio_bitrate": { "type": "string", "default": "192k" }
      }
    },
    "export_presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "container", "video_codec", "audio_codec"],
        "properties": {
          "name": { "type": "string" },
          "container": { "type": "string" },
          "video_codec": { "type": "string" },
          "audio_codec": { "type": "string" },
          "video_bitrate": { "type": "string" },
          "audio_bitrate": { "type": "string" }
        }
      }
    }
  }
}
