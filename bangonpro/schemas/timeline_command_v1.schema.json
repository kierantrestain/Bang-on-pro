{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangonpro.dev/schemas/timeline_command_v1.schema.json",
  "title": "Bang On Pro Native AI Timeline Command API v1",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "sequence_id",
    "expected_revision",
    "actor",
    "operations"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "requires_approval": { "type": "boolean", "default": true }
      }
    },
    "transaction_label": {
      "type": "string",
      "default": "AI Edit Batch"
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op_id", "type"],
        "properties": {
          "op_id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "import_media",
              "sync_clips",
              "create_sequence",
              "create_track",
              "place_clip",
              "move_clip",
              "trim_clip",
              "split_clip",
              "delete_clip",
              "select_camera",
              "add_effect",
              "set_effect_param",
              "set_keyframe",
              "set_audio_level",
              "add_audio_filter",
              "add_caption",
              "add_marker",
              "undo",
              "redo",
              "export_sequence"
            ]
          },
          "media_ref": { "type": "string" },
          "clip_id": { "type": "string" },
          "track_id": { "type": "string" },
          "frame_range": {
            "type": "object",
            "properties": {
              "in_frame": { "type": "integer", "minimum": 0 },
              "out_frame": { "type": "integer", "minimum": 0 },
              "timeline_start": { "type": "integer", "minimum": 0 },
              "fps_num": { "type": "integer", "minimum": 1, "default": 25 },
              "fps_den": { "type": "integer", "minimum": 1, "default": 1 }
            }
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
