{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bangonpro.dev/schemas/timeline_command_v1.schema.json",
  "title": "Bang On Pro Native AI Timeline Command API v1",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "sequence_id",
    "expected_revision",
    "actor",
    "operations"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "requires_approval": { "type": "boolean", "default": true }
      }
    },
    "transaction_label": {
      "type": "string",
      "default": "AI Edit Batch"
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op_id", "type"],
        "properties": {
          "op_id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "import_media",
              "sync_clips",
              "create_sequence",
              "create_track",
              "place_clip",
              "move_clip",
              "trim_clip",
              "split_clip",
              "delete_clip",
              "select_camera",
              "add_effect",
              "set_effect_param",
              "set_keyframe",
              "set_audio_level",
              "add_audio_filter",
              "add_caption",
              "update_caption",
              "delete_caption",
              "add_marker",
              "apply_mask",
              "add_transition",
              "add_lower_third",
              "set_clip_speed",
              "undo",
              "redo",
              "export_sequence"
            ]
          },
          "media_ref": { "type": "string" },
          "clip_id": { "type": "string" },
          "track_id": { "type": "string" },
          "frame_range": {
            "type": "object",
            "properties": {
              "in_frame": { "type": "integer", "minimum": 0 },
              "out_frame": { "type": "integer", "minimum": 0 },
              "timeline_start": { "type": "integer", "minimum": 0 },
              "fps_num": { "type": "integer", "minimum": 1, "default": 25 },
              "fps_den": { "type": "integer", "minimum": 1, "default": 1 }
            }
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "rationale": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "apply_mask" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "mask_id": { "type": "string", "minLength": 1 },
                    "mask_type": {
                      "type": "string",
                      "enum": ["spline", "polygon", "bezier", "matte_file", "ai_sam"]
                    },
                    "splines_json": {
                      "type": ["string", "object", "array"]
                    },
                    "matte_path": { "type": "string", "minLength": 1 },
                    "feather": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                    "expand": { "type": "number", "minimum": -50.0, "maximum": 50.0 },
                    "invert": { "type": "boolean" },
                    "operation": {
                      "type": "string",
                      "enum": ["write_on_clear", "add", "subtract", "intersect"]
                    },
                    "keyframes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["frame", "points"],
                        "properties": {
                          "frame": { "type": "integer", "minimum": 0 },
                          "points": { "type": "array" }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "add_transition" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "transition_id": { "type": "string", "minLength": 1 },
                    "a_track": { "type": ["string", "integer"] },
                    "b_track": { "type": ["string", "integer"] },
                    "in_frame": { "type": "integer", "minimum": 0 },
                    "out_frame": { "type": "integer", "minimum": 0 },
                    "properties": { "type": "object", "additionalProperties": true }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "update_caption" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "caption_id": { "type": "string", "minLength": 1 },
                    "text": { "type": "string", "minLength": 1 },
                    "speaker": { "type": "string" },
                    "language": { "type": "string" },
                    "start_frame": { "type": "integer", "minimum": 0 },
                    "end_frame": { "type": "integer", "minimum": 0 },
                    "duration_frames": { "type": "integer", "minimum": 1 }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "delete_caption" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "caption_id": { "type": "string", "minLength": 1 },
                    "start_frame": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "add_lower_third" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "speaker_name": { "type": "string", "minLength": 1 },
                    "subtitle": { "type": "string" },
                    "template": { "type": "string", "minLength": 1 },
                    "position": { "type": ["string", "object"] },
                    "duration_frames": { "type": "integer", "minimum": 1 }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "set_clip_speed" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "speed_percent": {
                      "type": "number",
                      "minimum": -10000.0,
                      "maximum": 10000.0,
                      "not": { "const": 0 }
                    },
                    "pitch_compensate": { "type": "boolean" },
                    "change_duration": { "type": "boolean" }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        ]
      }
    }
  }
}
